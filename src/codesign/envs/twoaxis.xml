<mujoco model="twoaxis">
  <!-- <include file="common/skybox.xml"/> -->
  <!-- <include file="common/visual.xml"/> -->
  <include file="materials.xml"/>


  <default>
    <!-- <default class="twoaxis">
      <joint limited="true" damping=".01" armature=".1" stiffness="8" type="hinge" axis="0 1 0"/>
      <geom contype="1" conaffinity="1" condim="3" friction=".4 .1 .1" material="self"/>
    </default> -->
    <default class="free">
      <joint limited="false" damping="0" armature="0" stiffness="0"/>
    </default>
    <position ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <asset>
    <!-- <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/> -->
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1"
      markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <!-- <visual>
    <global offwidth="2560" offheight="2560"/>
  </visual> -->

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="140" elevation="-20" offwidth="2560" offheight="2560"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
    <!-- <quality shadowsize="2048"/> -->
  </visual>

  <statistic center="0 0 .7" extent="2"/>

  <option timestep="0.1" iterations="4" ls_iterations="8">
    <flag eulerdamp="disable"/>
  </option>

  <custom>
    <numeric data="6" name="max_contact_points"/>
    <numeric data="4" name="max_geom_pairs"/>
  </custom>

  <worldbody>
    <geom name="ground" type="plane" conaffinity="1" pos="98 0 0" size="100 .8 .5" material="groundplane"/>
    <camera name="side_fixed" pos="2.0 -4.5 2.5" euler="70 0 0"/>
    <light name="light_overhead" pos="2 0 20" dir="0 0 -10" mode="fixed" specular="0.02 0.02 0.02" diffuse=".4 .4 .4" ambient=".1 .1 .1"/>
    <light name="light" pos="10 0 10" dir="-1 0 -10" mode="fixed" specular="1 1 1" diffuse=".8 .8 .8" ambient=".2 .2 .2"/>
    <body name="base" pos="0 0 .1">
      <camera name="track" pos="0 -3 0" quat="0.707 0.707 0 0" mode="trackcom"/>
      <camera name="back" pos="-1.8 -1.3 0.8" xyaxes="0.45 -0.9 0 0.3 0.15 0.94" mode="trackcom"/>
      <joint name="rootx" type="slide" range="-10 10" axis="1 0 0" damping=".5" armature=".1"/>
      <joint name="rooty" type="slide" range="-10 10" axis="0 1 0" damping=".5" armature=".1"/>
      <geom type="sphere" size=".1" rgba="0 0 1 1"/>
    </body>
  </worldbody>

  <sensor>
    <subtreelinvel name="base" body="base"/>
  </sensor>

  <actuator>
    <motor name="rootx" joint="rootx" forcelimited="true" forcerange="-5 5"/>
    <motor name="rooty" joint="rooty" forcelimited="true" forcerange="-5 5"/>
  </actuator>
</mujoco>